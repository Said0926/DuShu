# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- Django ---
# Сгенерировать ключ:
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Эти три переменные читает и контейнер postgres, и DATABASE_URL ниже.
POSTGRES_DB=dushu
POSTGRES_USER=dushu
POSTGRES_PASSWORD=dushu
# Хост db — это имя сервиса из docker-compose.yml, а не localhost.
DATABASE_URL=postgres://dushu:dushu@db:5432/dushu

# --- перевод ---
# Ключ DeepL API Free: https://www.deepl.com/pro-api (Account -> API keys).
# Без ключа переключи провайдер на заглушку, она возвращает исходный текст:
#   TRANSLATION_PROVIDER=apps.translation.providers.dummy.DummyProvider
DEEPL_API_KEY=
TRANSLATION_PROVIDER=apps.translation.providers.deepl.DeepLProvider

# --- вход через Google ---
# Ключи заводятся в https://console.cloud.google.com:
#   APIs & Services -> OAuth consent screen (заполнить один раз)
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   тип Web application, Authorized redirect URI:
#     http://localhost:8000/accounts/google/login/callback/
# Пока значения пустые, кнопка «Войти через Google» не показывается,
# а вход по email и паролю работает как обычно.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
